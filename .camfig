# CAMFIG FILES ARE CASE SENSITIVE!!!

# The address that the server will serve from, accepts "localhost" for loopback, accepts "Any" for all network 
# interfaces (which are localhost, your IP, etc.), and any string which is a valid ip, e.g. "192.168.1.1".
Address:0.0.0.0
# The port that the server will bind to.
Port:80
# The port that the server will bind to if theres an issue initializing the server.
Fallback_Port:226
# The amount of times the server can crash and reset, if this is exceeded the program will exit with an error.
Reset_Limit:5